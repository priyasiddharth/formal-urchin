+/-- A resolved place, carried in the SAME base+offset form as an
+    oseair `Val.Ptr`: the allocation it belongs to, and how far into it
+    the place sits. Every constructor below builds `offset` by ADDITION
+    (zero for a whole local, the accumulated path offsets for a
+    projection, the loaded pointer's own offset for a deref), which is
+    exactly how oseair's `Rhs.Borrow` accumulates. Keeping the two
+    machines in one representation is what makes the simulation's
+    pointer-offset conjunct hold on the nose instead of through
+    `allocBase ≤ addr` arithmetic. -/
 structure PlaceRes where
-  addr      : Word
-  tag       : Tag
   allocBase : Word
+  offset    : Word
+  tag       : Tag
   allocSize : Word
 
+/-- The absolute address, derived. Every use of a resolved place as an
+    ADDRESS — memory lookups, permission calls, bounds checks — goes
+    through this. -/
+abbrev PlaceRes.addr (r : PlaceRes) : Word := r.allocBase + r.offset
+
+/-- `.addr` on a literal reduces. Definitional, but `rw` matches up to
+    instances only, so proofs that pattern-match on the absolute address
+    need this in their simp set. -/
+theorem PlaceRes.addr_mk (b o : Word) (t : Tag) (sz : Word) :
+    (PlaceRes.mk b o t sz).addr = b + o := rfl
+
+/-- Advancing the offset advances the absolute address by the same
+    amount. This is the bridge the reparameterization needs: a
+    projection now accumulates on `offset` (right-associating under
+    `addr = allocBase + offset`), while every consumer speaks of the
+    absolute address (left-associating). -/
+@[simp] theorem PlaceRes.addr_shift (r : PlaceRes) (k : Word) :
+    ({ r with offset := r.offset + k } : PlaceRes).addr = r.addr + k := by
+  show r.allocBase + (r.offset + k) = r.allocBase + r.offset + k
+  exact (Nat.add_assoc _ _ _).symm
+
