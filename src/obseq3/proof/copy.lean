theorem compileStmt_copy_projdst_srcflatten_run
    {Γ : Ctx} {τ σ : LayoutTy}
    (dbase : Place Γ σ) (path : PathTo σ τ)
    (src : Place Γ τ) (cs : CompilerState) :
