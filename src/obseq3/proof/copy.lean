theorem compileStmt_copy_derefdst_srcflatten_run
    {Γ : Ctx} {τ : LayoutTy}
    (pp : Place Γ (obseq.LayoutTy.PtrL τ)) (src : Place Γ τ) (cs : CompilerState) :
