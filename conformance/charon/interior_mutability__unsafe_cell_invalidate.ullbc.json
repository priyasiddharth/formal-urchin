"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"prep/interior_mutability__unsafe_cell_invalidate.rs"},"crate_name":"interior_mutability__unsafe_cell_invalidate","contents":"// derived from miri tests/pass/both_borrows/interior_mutability.rs @ 34d6a7954\n// scenario: unsafe_cell_invalidate — writing through a parent raw pops a\n// protected &UnsafeCell argument, and that is allowed (weak protection\n// on SharedReadWrite).\n// expected: ok\n// rewrites: scenario extracted; mem::transmute(raw2) ->\n//           &*(raw2 as *const UnsafeCell<i32>) (an SRW reborrow instead\n//           of a tag-preserving transmute; same pass verdict);\n//           *y += 1 -> read then write\n\nuse std::cell::UnsafeCell;\n\nfn f(_x: &UnsafeCell<i32>, y: *mut i32) {\n    unsafe {\n        let _t = *y;\n        *y = 1;\n    }\n}\n\nfn main() {\n    let mut x = 0i32;\n    let raw1 = &mut x as *mut i32;\n    let ref1 = unsafe { &mut *raw1 };\n    let raw2 = ref1 as *mut i32;\n    f(unsafe { &*(raw2 as *const UnsafeCell<i32>) }, raw1);\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/cell.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["interior_mutability__unsafe_cell_invalidate",0]},{"Ident":["f",0]}]},{"key":{"Fun":1},"value":[{"Ident":["interior_mutability__unsafe_cell_invalidate",0]},{"Ident":["main",0]}]},{"key":{"Type":0},"value":[{"Ident":["core",0]},{"Ident":["cell",0]},{"Ident":["UnsafeCell",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"HashConsedValue":[265,{"Literal":{"Int":"I32"}}]}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}]}],"assoc_item_names":[],"short_names":[{"key":{"Type":0},"value":[{"Ident":["UnsafeCell",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":265}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}]},{"key":{"Fun":1},"value":[{"Ident":["main",0]}]},{"key":{"Fun":0},"value":[{"Ident":["f",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cell",0]},{"Ident":["UnsafeCell",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":265}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":1,"beg":{"line":2323,"col":0},"end":{"line":2323,"col":32}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The core primitive for interior mutability in Rust."},{"DocComment":""},{"DocComment":" If you have a reference `&T`, then normally in Rust the compiler performs optimizations based on"},{"DocComment":" the knowledge that `&T` points to immutable data. Mutating that data, for example through an"},{"DocComment":" alias or by transmuting a `&T` into a `&mut T`, is considered undefined behavior."},{"DocComment":" `UnsafeCell<T>` opts-out of the immutability guarantee for `&T`: a shared reference"},{"DocComment":" `&UnsafeCell<T>` may point to data that is being mutated. This is called \"interior mutability\"."},{"DocComment":""},{"DocComment":" All other types that allow internal mutability, such as [`Cell<T>`] and [`RefCell<T>`], internally"},{"DocComment":" use `UnsafeCell` to wrap their data."},{"DocComment":""},{"DocComment":" Note that only the immutability guarantee for shared references is affected by `UnsafeCell`. The"},{"DocComment":" uniqueness guarantee for mutable references is unaffected. There is *no* legal way to obtain"},{"DocComment":" aliasing `&mut`, not even with `UnsafeCell<T>`."},{"DocComment":""},{"DocComment":" `UnsafeCell` does nothing to avoid data races; they are still undefined behavior. If multiple"},{"DocComment":" threads have access to the same `UnsafeCell`, they must follow the usual rules of the"},{"DocComment":" [concurrent memory model]: conflicting non-synchronized accesses must be done via the APIs in"},{"DocComment":" [`core::sync::atomic`]."},{"DocComment":""},{"DocComment":" The `UnsafeCell` API itself is technically very simple: [`.get()`] gives you a raw pointer"},{"DocComment":" `*mut T` to its contents. It is up to _you_ as the abstraction designer to use that raw pointer"},{"DocComment":" correctly."},{"DocComment":""},{"DocComment":" [`.get()`]: `UnsafeCell::get`"},{"DocComment":" [concurrent memory model]: ../sync/atomic/index.html#memory-model-for-atomic-accesses"},{"DocComment":""},{"DocComment":" # Aliasing rules"},{"DocComment":""},{"DocComment":" The precise Rust aliasing rules are somewhat in flux, but the main points are not contentious:"},{"DocComment":""},{"DocComment":" - If you create a safe reference with lifetime `'a` (either a `&T` or `&mut T` reference), then"},{"DocComment":"   you must not access the data in any way that contradicts that reference for the remainder of"},{"DocComment":"   `'a`. For example, this means that if you take the `*mut T` from an `UnsafeCell<T>` and cast it"},{"DocComment":"   to an `&T`, then the data in `T` must remain immutable (modulo any `UnsafeCell` data found"},{"DocComment":"   within `T`, of course) until that reference's lifetime expires. Similarly, if you create a"},{"DocComment":"   `&mut T` reference that is released to safe code, then you must not access the data within the"},{"DocComment":"   `UnsafeCell` until that reference expires."},{"DocComment":""},{"DocComment":" - For both `&T` without `UnsafeCell<_>` and `&mut T`, you must also not deallocate the data"},{"DocComment":"   until the reference expires. As a special exception, given an `&T`, any part of it that is"},{"DocComment":"   inside an `UnsafeCell<_>` may be deallocated during the lifetime of the reference, after the"},{"DocComment":"   last time the reference is used (dereferenced or reborrowed). Since you cannot deallocate a part"},{"DocComment":"   of what a reference points to, this means the memory an `&T` points to can be deallocated only if"},{"DocComment":"   *every part of it* (including padding) is inside an `UnsafeCell`."},{"DocComment":""},{"DocComment":" However, whenever a `&UnsafeCell<T>` is constructed or dereferenced, it must still point to"},{"DocComment":" live memory and the compiler is allowed to insert spurious reads if it can prove that this"},{"DocComment":" memory has not yet been deallocated."},{"DocComment":""},{"DocComment":" To assist with proper design, the following scenarios are explicitly declared legal"},{"DocComment":" for single-threaded code:"},{"DocComment":""},{"DocComment":" 1. A `&T` reference can be released to safe code and there it can co-exist with other `&T`"},{"DocComment":"    references, but not with a `&mut T`"},{"DocComment":""},{"DocComment":" 2. A `&mut T` reference may be released to safe code provided neither other `&mut T` nor `&T`"},{"DocComment":"    co-exist with it. A `&mut T` must always be unique."},{"DocComment":""},{"DocComment":" Note that whilst mutating the contents of an `&UnsafeCell<T>` (even while other"},{"DocComment":" `&UnsafeCell<T>` references alias the cell) is"},{"DocComment":" ok (provided you enforce the above invariants some other way), it is still undefined behavior"},{"DocComment":" to have multiple `&mut UnsafeCell<T>` aliases. That is, `UnsafeCell` is a wrapper"},{"DocComment":" designed to have a special interaction with _shared_ accesses (_i.e._, through an"},{"DocComment":" `&UnsafeCell<_>` reference); there is no magic whatsoever when dealing with _exclusive_"},{"DocComment":" accesses (_e.g._, through a `&mut UnsafeCell<_>`): neither the cell nor the wrapped value"},{"DocComment":" may be aliased for the duration of that `&mut` borrow."},{"DocComment":" This is showcased by the [`.get_mut()`] accessor, which is a _safe_ getter that yields"},{"DocComment":" a `&mut T`."},{"DocComment":""},{"DocComment":" [`.get_mut()`]: `UnsafeCell::get_mut`"},{"DocComment":""},{"DocComment":" # Memory layout"},{"DocComment":""},{"DocComment":" `UnsafeCell<T>` has the same in-memory representation as its inner type `T`. A consequence"},{"DocComment":" of this guarantee is that it is possible to convert between `T` and `UnsafeCell<T>`."},{"DocComment":" Special care has to be taken when converting a nested `T` inside of an `Outer<T>` type"},{"DocComment":" to an `Outer<UnsafeCell<T>>` type: this is not sound when the `Outer<T>` type enables [niche]"},{"DocComment":" optimizations. For example, the type `Option<NonNull<u8>>` is typically 8 bytes large on"},{"DocComment":" 64-bit platforms, but the type `Option<UnsafeCell<NonNull<u8>>>` takes up 16 bytes of space."},{"DocComment":" Therefore this is not a valid conversion, despite `NonNull<u8>` and `UnsafeCell<NonNull<u8>>>`"},{"DocComment":" having the same memory layout. This is because `UnsafeCell` disables niche optimizations in"},{"DocComment":" order to avoid its interior mutability property from spreading from `T` into the `Outer` type,"},{"DocComment":" thus this can cause distortions in the type size in these cases."},{"DocComment":""},{"DocComment":" Note that the only valid way to obtain a `*mut T` pointer to the contents of a"},{"DocComment":" _shared_ `UnsafeCell<T>` is through [`.get()`]  or [`.raw_get()`]. A `&mut T` reference"},{"DocComment":" can be obtained by either dereferencing this pointer or by calling [`.get_mut()`]"},{"DocComment":" on an _exclusive_ `UnsafeCell<T>`. Even though `T` and `UnsafeCell<T>` have the"},{"DocComment":" same memory layout, the following is not allowed and undefined behavior:"},{"DocComment":""},{"DocComment":" ```rust,compile_fail"},{"DocComment":" # use std::cell::UnsafeCell;"},{"DocComment":" unsafe fn not_allowed<T>(ptr: &UnsafeCell<T>) -> &mut T {"},{"DocComment":"   let t = ptr as *const UnsafeCell<T> as *mut T;"},{"DocComment":"   // This is undefined behavior, because the `*mut T` pointer"},{"DocComment":"   // was not obtained through `.get()` nor `.raw_get()`:"},{"DocComment":"   unsafe { &mut *t }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Instead, do this:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::cell::UnsafeCell;"},{"DocComment":" // Safety: the caller must ensure that there are no references that"},{"DocComment":" // point to the *contents* of the `UnsafeCell`."},{"DocComment":" unsafe fn get_mut<T>(ptr: &UnsafeCell<T>) -> &mut T {"},{"DocComment":"   unsafe { &mut *ptr.get() }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Converting in the other direction from a `&mut T`"},{"DocComment":" to an `&UnsafeCell<T>` is allowed:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::cell::UnsafeCell;"},{"DocComment":" fn get_shared<T>(ptr: &mut T) -> &UnsafeCell<T> {"},{"DocComment":"   let t = ptr as *mut T as *const UnsafeCell<T>;"},{"DocComment":"   // SAFETY: `T` and `UnsafeCell<T>` have the same memory layout"},{"DocComment":"   unsafe { &*t }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [niche]: https://rust-lang.github.io/unsafe-code-guidelines/glossary.html#niche"},{"DocComment":" [`.raw_get()`]: `UnsafeCell::raw_get`"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Here is an example showcasing how to soundly mutate the contents of an `UnsafeCell<_>` despite"},{"DocComment":" there being multiple references aliasing the cell:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::cell::UnsafeCell;"},{"DocComment":""},{"DocComment":" let x: UnsafeCell<i32> = 42.into();"},{"DocComment":" // Get multiple / concurrent / shared references to the same `x`."},{"DocComment":" let (p1, p2): (&UnsafeCell<i32>, &UnsafeCell<i32>) = (&x, &x);"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     // SAFETY: within this scope there are no other references to `x`'s contents,"},{"DocComment":"     // so ours is effectively unique."},{"DocComment":"     let p1_exclusive: &mut i32 = &mut *p1.get(); // -- borrow --+"},{"DocComment":"     *p1_exclusive += 27; //                                     |"},{"DocComment":" } // <---------- cannot go beyond this point -------------------+"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     // SAFETY: within this scope nobody expects to have exclusive access to `x`'s contents,"},{"DocComment":"     // so we can have multiple shared accesses concurrently."},{"DocComment":"     let p2_shared: &i32 = &*p2.get();"},{"DocComment":"     assert_eq!(*p2_shared, 42 + 27);"},{"DocComment":"     let p1_shared: &i32 = &*p1.get();"},{"DocComment":"     assert_eq!(*p1_shared, *p2_shared);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The following example showcases the fact that exclusive access to an `UnsafeCell<T>`"},{"DocComment":" implies exclusive access to its `T`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" #![forbid(unsafe_code)]"},{"DocComment":" // with exclusive accesses, `UnsafeCell` is a transparent no-op wrapper, so no need for"},{"DocComment":" // `unsafe` here."},{"DocComment":" use std::cell::UnsafeCell;"},{"DocComment":""},{"DocComment":" let mut x: UnsafeCell<i32> = 42.into();"},{"DocComment":""},{"DocComment":" // Get a compile-time-checked unique reference to `x`."},{"DocComment":" let p_unique: &mut UnsafeCell<i32> = &mut x;"},{"DocComment":" // With an exclusive reference, we can mutate the contents for free."},{"DocComment":" *p_unique.get_mut() = 0;"},{"DocComment":" // Or, equivalently:"},{"DocComment":" x = UnsafeCell::new(0);"},{"DocComment":""},{"DocComment":" // When we own the value, we can extract the contents for free."},{"DocComment":" let contents: i32 = x.into_inner();"},{"DocComment":" assert_eq!(contents, 0);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"UnsafeCell","diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"}],"fun_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["interior_mutability__unsafe_cell_invalidate",0]},{"Ident":["f",0]}],"span":{"data":{"file_id":0,"beg":{"line":13,"col":0},"end":{"line":18,"col":1}},"generated_from_span":null},"source_text":"fn f(_x: &UnsafeCell<i32>, y: *mut i32) {\n    unsafe {\n        let _t = *y;\n        *y = 1;\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[292,{"Ref":[{"Var":{"Bound":[0,0]}},{"HashConsedValue":[266,{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},"Shared"]}]},{"HashConsedValue":[268,{"RawPtr":[{"Deduplicated":265},"Mut"]}]}],"output":{"HashConsedValue":[269,{"Adt":{"id"