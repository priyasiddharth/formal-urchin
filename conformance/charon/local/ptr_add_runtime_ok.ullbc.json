able_unchecked()` is perfectly sound in the following"},{"DocComment":" example, as the compiler is able to prove that a division by zero is not"},{"DocComment":" possible, benchmarking reveals that `unreachable_unchecked()` provides"},{"DocComment":" no benefit over using [`unreachable!`], while the latter does not introduce"},{"DocComment":" the possibility of Undefined Behavior."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn div_1(a: u32, b: u32) -> u32 {"},{"DocComment":"     use std::hint::unreachable_unchecked;"},{"DocComment":""},{"DocComment":"     // `b.saturating_add(1)` is always positive (not zero),"},{"DocComment":"     // hence `checked_div` will never return `None`."},{"DocComment":"     // Therefore, the else branch is unreachable."},{"DocComment":"     a.checked_div(b.saturating_add(1))"},{"DocComment":"         .unwrap_or_else(|| unsafe { unreachable_unchecked() })"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(div_1(7, 0), 7);"},{"DocComment":" assert_eq!(div_1(9, 1), 4);"},{"DocComment":" assert_eq!(div_1(11, u32::MAX), 0);"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"data":{"file_id":8,"beg":{"line":102,"col":0},"end":{"line":102,"col":15}},"generated_from_span":null}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[],"output":{"Deduplicated":324}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":4,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["boxed",0]},{"Ident":["Box",0]},{"Impl":{"Trait":0}},{"Ident":["drop_glue",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_bin