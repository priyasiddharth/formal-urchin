ointer to some\n[allocation], and the entire memory range between `self` and the result must be in\nbounds of that allocation. In particular, this range must not \"wrap around\" the edge\nof the address space.\n\nAllocations can never be larger than `isize::MAX` bytes, so if the computed offset\nstays in bounds of the allocation, it is guaranteed to satisfy the first requirement.\nThis implies, for instance, that `vec.as_ptr().add(vec.len())` (for `vec: Vec<T>`) is always\nsafe.\n\nConsider using [`wrapping_add`] instead if these constraints are\ndifficult to satisfy. The only advantage of this method is that it\nenables more aggressive compiler optimizations.\n\n[`wrapping_add`]: #method.wrapping_add\n[allocation]: crate::ptr#allocation\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s: &str = \"123\";"},{"DocComment":" let ptr: *const u8 = s.as_ptr();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     assert_eq!(*ptr.add(1), b'2');"},{"DocComment":"     assert_eq!(*ptr.add(2), b'3');"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"data":{"file_id":6,"beg":{"line":828,"col":4},"end":{"line":828,"col":19}},"generated_from_span":null}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":228},{"Deduplicated":225}],"output":{"Deduplicated":228}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hint",0]},{"Ident":["unreachable_unchecked",0]}],"span":{"data":{"file_id":8,"beg":{"line":103,"col":0},"end":{"line":103,"col":48}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Informs the compiler that the site which is calling this function is not"},{"DocComment":" reachable, possibly enabling further optimizations."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Reaching this function is *Undefined Behavior*."},{"DocComment":""},{"DocComment":" As the compiler assumes that all forms of Undefined Behavior can never"},{"DocComment":" happen, it will eliminate all branches in the surrounding code that it can"},{"DocComment":" determine will invariably lead to a call to `unreachable_unchecked()`."},{"DocComment":""},{"DocComment":" If the assumptions embedded in using this function turn out to be wrong -"},{"DocComment":" that is, if the site which is calling `unreachable_unchecked()` is actually"},{"DocComment":" reachable at runtime - the compiler may have generated nonsensical machine"},{"DocComment":" instructions for this situation, including in seemingly unrelated code,"},{"DocComment":" causing difficult-to-debug problems."},{"DocComment":""},{"DocComment":" Use this function sparingly. Consider using the [`unreachable!`] macro,"},{"DocComment":" which may prevent some optimizations but will safely panic in case it is"},{"DocComment":" actually reached at runtime. Benchmark your code to find out if using"},{"DocComment":" `unreachable_unchecked()` comes with a performance benefit."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `unreachable_unchecked()` can be used in situations where the compiler"},{"DocComment":" can't prove invariants that were previously established. Such situations"},{"DocComment":" have a higher chance of occurring if those invariants are upheld by"},{"DocComment":" external code that the compiler can't analyze."},{"DocComment":" ```"},{"DocComment":" fn prepare_inputs(divisors: &mut Vec<u32>) {"},{"DocComment":"     // Note to future-self when making changes: The invariant established"},{"DocComment":"     // here is N