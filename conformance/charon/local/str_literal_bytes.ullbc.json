ressive compiler optimizations.\n\n[`wrapping_add`]: #method.wrapping_add\n[allocation]: crate::ptr#allocation\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s: &str = \"123\";"},{"DocComment":" let ptr: *const u8 = s.as_ptr();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     assert_eq!(*ptr.add(1), b'2');"},{"DocComment":"     assert_eq!(*ptr.add(2), b'3');"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"data":{"file_id":3,"beg":{"line":828,"col":4},"end":{"line":828,"col":19}},"generated_from_span":null}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":222},{"Deduplicated":522}],"output":{"Deduplicated":222}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hint",0]},{"Ident":["unreachable_unchecked",0]}],"span":{"data":{"file_id":5,"beg":{"line":103,"col":0},"end":{"line":103,"col":48}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Informs the compiler that the site which is calling this function is not"},{"DocComment":" reachable, possibly enabling further optimizations."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Reaching this function is *Undefined Behavior*."},{"DocComment":""},{"DocComment":" As the compiler assumes that all forms of Undefined Behavior can never"},{"DocComment":" happen, it will eliminate all branches in the surrounding code that it can"},{"DocComment":" determine will invariably lead to a call to `unreachable_unchecked()`."},{"DocComment":""},{"DocComment":" If the assumptions embedded in using this function turn out to be wrong -"},{"DocComment":" that is, if the site which is calling `unreachable_unchecked()` is actually"},{"DocComment":" reachable at runtime - the compiler may have generated nonsensical machine"},{"DocComment":" instructions for this situation, including in seemingly unrelated code,"},{"DocComment":" causing difficult-to-debug problems."},{"DocComment":""},{"DocComment":" Use this function sparingly. Consider using the [`unreachable!`] macro,"},{"DocComment":" which may prevent some optimizations but will safely panic in case it is"},{"DocComment":" actually reached at runtime. Benchmark your code to find out if using"},{"DocComment":" `unreachable_unchecked()` comes with a performance benefit."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `unreachable_unchecked()` can be used in situations where the compiler"},{"DocComment":" can't prove invariants that were previously established. Such situations"},{"DocComment":" have a higher chance of occurring if those invariants are upheld by"},{"DocComment":" external code that the compiler can't analyze."},{"DocComment":" ```"},{"DocComment":" fn prepare_inputs(divisors: &mut Vec<u32>) {"},{"DocComment":"     // Note to future-self when making changes: The invariant established"},{"DocComment":"     // here is NOT checked in `do_computation()`; if this changes, you HAVE"},{"DocComment":"     // to change `do_computation()`."},{"DocComment":"     divisors.retain(|divisor| *divisor != 0)"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" /// # Safety"},{"DocComment":" /// All elements of `divisor` must be non-zero."},{"DocComment":" unsafe fn do_computation(i: u32, divisors: &[u32]) -> u32 {"},{"DocComment":"     divisors.iter().fold(i, |acc, divisor| {"},{"DocComment":"         // Convince the compiler that a division by zero can't happen here"},{"DocComment":"         // and a check is not needed below."},{"DocComment":"         if *divisor == 0 {"},{"DocComment":"             // Safety: `divisor` can't be zero because of `prepare_inputs`,"},{"DocComment":"             // but the compiler does not know about this. We *promise*"},{"DocComment":"             // that we always call `prepare_inputs`."},{"DocComment":"             unsafe { std::hint::unreachable_unchecked() }"},{"DocComment":"         }"},{"DocComment":"         // The compiler would normally introduce a check here that prevents"},{"DocComment":"         // a division by zero. However, if `divisor` was zero, the branch"},{"DocComment":"         // above would reach what we explicitly marked as unreachable."},{"DocComment":"         // The compiler concludes that `divisor` can't be zero at this point"},{"DocComment":"         // and removes the - now proven useless - check."},{"DocComment":"         acc / divisor"},{"DocComment":"     })"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut divisors = vec![2, 0, 4];"},{"DocComment":" prepare_inputs(&mut divisors);"},{"DocComment":" let result = unsafe {"},{"DocComment":"     // Safety: prepare_inputs() guarantees that divisors is non-zero"},{"DocComment":"     do_computation(100, &divisors)"},{"DocComment":" };"},{"DocComment":" assert_eq!(result, 12);"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While using `unreachable_unchecked()` is perfectly sound in the following"},{"DocComment":" example, as the compiler is able to prove that a division by zero is not"},{"DocComment":" possible, benchmarking reveals that `unreachable_unchecked()` provides"},{"DocComment":" no benefit over using [`unreachable!`], while the latter does not introduce"},{"DocComment":" the possibility of Undefined Behavior."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn div_1(a: u32, b: u32) -> u32 {"},{"DocComment":"     use std::hint::unreachable_unchecked;"},{"DocComment":""},{"DocComment":"     // `b.saturating_add(1)` is always positive (not zero),"},{"DocComment":"     // hence `checked_div` will never return `None`."},{"DocComment":"     // Therefore, the else branch is unreachable."},{"DocComment":"     a.checked_div(b.saturating_add(1))"},{"DocComment":"         .unwrap_or_else(|| unsafe { unreachable_unchecked() })"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(div_1(7, 0), 7);"},{"DocComment":" assert_eq!(div_1(9, 1), 4);"},{"DocComment":" assert_eq!(div_1(11, u32::MAX), 0);"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"data":{"file_id":5,"beg":{"line":102,"col":0},"end":{"line":102,"col":15}},"generated_from_span":null}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[],"output":{"Deduplicated":227}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"}],"global_decls":[],"trait_decls":[],"trait_impls":[],"ordered_decls":[{"Fun":{"NonRec":3}},{"Fun":{"NonRec":2}},{"Fun":{"NonRec":1}},{"Fun":{"NonRec":0}}]},"has_errors":false}