"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"data":{"file_id":6,"beg":{"line":926,"col":4},"end":{"line":926,"col":19}},"generated_from_span":null}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":248},{"Deduplicated":278}],"output":{"Deduplicated":248}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":4,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["dealloc",0]}],"span":{"data":{"file_id":4,"beg":{"line":120,"col":0},"end":{"line":120,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Deallocates memory with the global allocator."},{"DocComment":""},{"DocComment":" This function forwards calls to the [`GlobalAlloc::dealloc`] method"},{"DocComment":" of the allocator registered with the `#[global_allocator]` attribute"},{"DocComment":" if there is one, or the `std` crate’s default."},{"DocComment":""},{"DocComment":" This function is expected to be deprecated in favor of the `deallocate` method"},{"DocComment":" of the [`Global`] type when it and the [`Allocator`] trait become stable."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" See [`GlobalAlloc::dealloc`]."},{"Builtin":{"TrackCaller":{"data":{"file_id":4,"beg":{"line":119,"col":17},"end":{"line":119,"col":29}},"generated_from_span":null}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust"