ents":[]}}},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["const_ptr",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":216},"kind":"InherentImplBlock"}}},{"Ident":["cast_mut",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":214}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":2,"beg":{"line":145,"col":4},"end":{"line":145,"col":41}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Changes constness without changing the type."},{"DocComment":""},{"DocComment":" This is a bit safer than `as` because it wouldn't silently change the type if the code is"},{"DocComment":" refactored."},{"Builtin":{"RustcDiagnosticItem":"ptr_cast_mut"}}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"ptr_cast_mut"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":216}],"output":{"Deduplicated":218}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["drop_in_place",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":214}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":1,"beg":{"line":808,"col":0},"end":{"line":810,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Executes the destructor (if any) of the pointed-to value."},{"DocComment":""},{"DocComment":" This is almost the same as calling [`ptr::read`] and discarding"},{"DocComment":" the result, but has the following advantages:"},{"DocComment":""},{"DocComment":" * It is *required* to use `drop_in_place` to drop unsized types like"},{"DocComment":"   trait objects, because they can't be read out onto the stack and"},{"DocComment":"   dropped normally."},{"DocComment":""},{"DocComment":" * It is friendlier to the optimizer to do this over [`ptr::read`] when"},{"DocComment":"   dropping manually allocated memory (e.g., in the implementations of"},{"DocComment":"   `Box`/`Rc`/`Vec`), as the compiler doesn't need to prove that it's"},{"DocComment":"   sound to elide the copy."},{"DocComment":""},{"DocComment":" * It can be used to drop [pinned] data when `T` is not `repr(packed)`"},{"DocComment":"   (pinned data must not be moved before it is dropped)."},{"DocComment":""},{"DocComment":" Unaligned values cannot be dropped in place, they must be copied to an aligned"},{"DocComment":" location first using [`ptr::read_unaligned`]. For packed structs, this move is"},{"DocComment":" done automatically by the compiler. This means the fields of packed structs"},{"DocComment":" are not dropped in-place."},{"DocComment":""},{"DocComment":" [`ptr::read`]: self::read"},{"DocComment":" [`ptr::read_unaligned`]: self::read_unaligned"},{"DocComment":" [pinned]: crate::pin"},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `to_drop` must be [valid] for both reads and writes."},{"DocComment":""},{"DocComment":" * `to_drop` must be properly aligned, even if `T` has size 0."},{"DocComment":""},{"DocComment":" * `to_drop` must be nonnull, even if `T` has size 0."},{"DocComment":""},{"DocComment":" * The value `to_drop` points to must be valid for dropping, which may mean"},{"DocComment":"   it must uphold additional invariants. These invariants depend on the type"},{"DocComment":"   of the value being dropped. For instance, when dropping a Box, the box's"},{"DocComment":"   pointer to the heap must be valid."},{"DocComment":""},{"DocComment":" * While `drop_in_place` is executing, the only way to access parts of"},{"DocComment":"   `to_drop` is through the `&mut self` references supplied to the"},{"DocComment":"   `Drop::drop` methods that `drop_in_place` invokes."},{"DocComment":""},{"DocComment":" Additionally, if `T` is not [`Copy`], using the pointed-to value after"},{"DocComment":" calling `drop_in_place` can cause undefined behavior. Note that `*to_drop ="},{"DocComment":" foo` counts as a use because it will cause the value to be dropped"},{"DocComment":" again. [`write()`] can be used to overwrite data without causing it to be"},{"DocComment":" dropped."},{"DocComment":""},{"DocComment":" [valid]: self#safety"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Manually remove the last item from a vector:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr;"},{"DocComment":" use std::rc::Rc;"},{"DocComment":""},{"DocComment":" let last = Rc::new(1);"},{"DocComment":" let weak = Rc::downgrade(&last);"},{"DocComment":""},{"DocComment":" let mut v = vec![Rc::new(0), last];"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     // Get a raw pointer to the last element in `v`."},{"DocComment":"     let ptr = &mut v[1] as *mut _;"},{"DocComment":"     // Shorten `v` to prevent the last item from being dropped. We do that first,"},{"DocComment":"     // to prevent issues if the `drop_in_place` below panics."},{"DocComment":"     v.set_len(1);"},{"DocComment":"     // Without a call `drop_in_place`, the last item would never be dropped,"},{"DocComment":"     // and the memory it manages would be leaked."},{"DocComment":"     ptr::drop_in_place(ptr);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(v, &[0.into()]);"},{"DocComment":""},{"DocComment":" // Ensure that the last item was dropped."},{"DocComment":" assert!(weak.upgrade().is_none());"},{"DocComment":" ```"},{"Builtin":{"RustcDiagnosticItem":"ptr_drop_in_place"}}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"ptr_drop_in_place"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":218}],"output":{"Deduplicated":212}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"}],"global_decls":[],"trait_decls":[],"trait_impls":[],"ordered_decls":[{"Fun":{"NonRec":1}},{"Fun":{"NonRec":2}},{"Fun":{"NonRec":0}}]},"has_errors":false}